# docker compose loads this file automatically for ${VAR} substitution in
# docker-compose.yml. Grouped by which tool each setting belongs to.

# ============================================================
# Profiles
# ============================================================

# COMPOSE_PROFILES is read automatically by `docker compose` itself (not a
# ${VAR} substitution) — it controls which profile-gated services actually
# start. coraza-service and crowdsec are both profile-gated; remove one (or
# both) here to skip building/running that container entirely with a normal
# `docker compose up`, e.g. COMPOSE_PROFILES=crowdsec to run without Coraza.
#
# This is a different knob from ENABLE_CORAZA/ENABLE_CROWDSEC below: those
# control scoring-service's *behavior* (skip that signal, same as the
# container being unreachable) without caring whether the container is
# actually running. This one controls whether the container runs at all.
# Setting ENABLE_CORAZA=true without "coraza" here still works (scoring
# just always sees it as unreachable) — just wastes the container.
#
# ai-tuner and ollama-local are opt-in, not in the default set below: add
# "ai-tuner" to run crs-tuner at all, and additionally "ollama-local" if
# you want the bundled local model rather than pointing OLLAMA_URL (further
# down) at a remote one — see that section for why they're separate.
# "claude-shim" is an alternative to "ollama-local" (not additive — run one
# or the other): an Ollama-API-compatible service backed by `claude -p`
# instead of local inference. See claude-shim/README.md before using it —
# real cost/latency numbers, not free, and needs
# claude-shim/setup-credentials.sh run first.
#
# "letsencrypt" runs letsencrypt-sidecar, which issues/renews real TLS
# certs for any routes.csv row with letsencrypt=true. Also uncomment
# envoy's port 80 mapping in docker-compose.yml (needed for the ACME
# HTTP-01 challenge) and set LETSENCRYPT_EMAIL below. Real issuance needs
# a real, owned, publicly-resolvable domain — this repo's own
# *.example.com domains can never actually succeed, by design of ACME
# validation, not a bug here.
COMPOSE_PROFILES=coraza,crowdsec

# ============================================================
# Envoy
# ============================================================

# Image tag for the envoy service in docker-compose.yml.
ENVOY_VERSION=v1.39.1

# Host ports Envoy publishes. Dynamic routing/TLS is driven by routes.csv
# (see envoy-control-plane/) — these just control what ports Envoy listens on
# for plain HTTP and TLS-terminated (SNI) traffic.
ENVOY_HTTP_PORT=10000
ENVOY_HTTPS_PORT=10443

# Host folder holding TLS cert/key pairs for routes.csv rows with ssl=true
# (see generate-cert.sh), relative to the project root. Mounted read-only
# into both envoy and envoy-control-plane.
SSL_DIR=envoy/ssl

# Request-handling limits, applied by envoy-control-plane to every generated
# route/cluster (envoy-control-plane/main.go).
#
# How much of the request body is buffered and handed to scoring-service for
# inspection (larger bodies aren't rejected, just truncated for the check).
EXT_AUTHZ_MAX_BODY_BYTES=8192
# How long the ext_authz scoring check itself may take before Envoy fails
# closed (FailureModeAllow is false — a timeout here denies the request).
EXT_AUTHZ_TIMEOUT_MS=200
# TCP connect timeout to any upstream (scoring-service, default-site, or a
# routes.csv target).
UPSTREAM_CONNECT_TIMEOUT_MS=1000
# Overall per-request timeout. 0 disables it entirely (Envoy's own
# RouteAction.timeout semantics) rather than falling back to a default —
# don't set this to 0 by accident.
REQUEST_TIMEOUT_S=15
# How long a stream may go completely silent (no bytes either direction)
# before Envoy resets it. Matters for long-lived responses like SSE: a
# backend that doesn't send periodic heartbeats needs this raised, or its
# connections get cut after this many seconds of silence.
STREAM_IDLE_TIMEOUT_S=300

# Host port the dashboard is published on.
DASHBOARD_PORT=8002

# Host interface the dashboard binds to. 127.0.0.1 (default) keeps it off the
# network entirely — only reachable from this host. Set to 0.0.0.0 to expose
# it beyond localhost; if you do, also set DASHBOARD_ALLOWED_IPS below, since
# the dashboard has no authentication of its own.
DASHBOARD_BIND_ADDR=127.0.0.1

# Comma-separated IPs/CIDRs allowed to reach the dashboard (app-level check,
# on top of DASHBOARD_BIND_ADDR above). Empty (default) = no restriction.
# Example: DASHBOARD_ALLOWED_IPS=10.0.0.0/8,192.168.1.42
DASHBOARD_ALLOWED_IPS=

# ============================================================
# Scoring — general (scoring-service/app/scoring.py, app/main.py)
# ============================================================

# Final score >= this is denied. See scoring.py's combine_scores/build_reasons.
RISK_THRESHOLD=0.8

# Set to true to score/log everything exactly as normal (dashboard shows what
# *would* happen) without actually blocking anything — every response is
# allowed regardless of decision. Useful for tuning RISK_THRESHOLD or a new
# rule against real traffic before it can affect anyone.
AUDIT_MODE=false

# ============================================================
# Coraza / OWASP CRS (coraza-service/)
# ============================================================

# Set to false to skip the Coraza/CRS call entirely (scoring falls back to the
# local heuristic only — same behavior as coraza-service being unreachable).
# To stop running the coraza-service container itself, see COMPOSE_PROFILES
# at the top of this file instead — this alone doesn't do that.
ENABLE_CORAZA=true

# OWASP Core Rule Set version. coraza-service fetches this itself on startup
# if crs/ is missing or holds a different version (see coraza-service/crs_fetch.go)
# — no manual step needed. Set to "latest" to resolve and fetch whatever
# CRS's newest GitHub release tag is at each startup.
CRS_VERSION=4.29.0

# CRS paranoia level (1-4): how strict the ruleset is. Higher catches more
# but raises false positives — most deployments run PL1 or PL2. Applied at
# startup (coraza-service/crs_fetch.go); restart coraza-service after
# changing it.
CRS_PARANOIA_LEVEL=1

# ============================================================
# CrowdSec (crowdsec/, scoring-service/app/crowdsec_client.py)
# ============================================================

# Set to false to skip feeding CrowdSec and checking its decisions entirely.
# To stop running the crowdsec container itself, see COMPOSE_PROFILES at the
# top of this file instead — this alone doesn't do that.
ENABLE_CROWDSEC=true

# Shared secret between scoring-service and the crowdsec container (its
# BOUNCER_KEY_scoring must match this). Change it — this default is only for
# local dev.
CROWDSEC_BOUNCER_KEY=devbouncerkeychangeme

# How often (seconds) scoring-service polls CrowdSec's decisions stream for
# its local cache, and coraza-service's /healthz for its live status. Lookups
# themselves are instant either way (a local dict read) — this only controls
# how fresh that local copy/status is.
CROWDSEC_POLL_INTERVAL=10

# ============================================================
# AI-tuned WAF exclusions (crs-tuner/, scoring-service/app/events.py)
# ============================================================
# Async, off the request path: CRS matches get queued (Redis Stream) and
# analyzed by an LLM judging true/false-positive. Once the *same*
# (domain, rule, variable) is independently judged a false positive
# AI_TUNER_FP_THRESHOLD times, a narrowly-scoped exclusion is generated into
# coraza-service/crs-exclusions/auto-<domain>.conf and hot-loaded — the
# ruleset tunes itself per domain over time. Requires the "ai-tuner" profile
# (COMPOSE_PROFILES above) to actually run crs-tuner at all.

# Set to false to skip queueing CRS matches for analysis entirely.
ENABLE_AI_TUNER=true

# Local by default (the bundled ollama service, profile "ollama-local") —
# point this at a remote/external Ollama-compatible endpoint instead if you
# don't want to run a model in this stack. Independent of the ollama-local
# profile: enabling ai-tuner doesn't require running a local model.
OLLAMA_URL=http://ollama:11434

# Only needed if OLLAMA_URL points at a remote/hosted endpoint sitting
# behind auth (a reverse proxy, a hosted Ollama-compatible gateway, ...) —
# the bundled local ollama service doesn't require it. Sent as
# "Authorization: Bearer <key>". Leave empty for local/unauthenticated use;
# with it empty, no Authorization header is sent at all.
OLLAMA_API_KEY=

# Model tag Ollama serves (pulled automatically on first startup if not
# already cached — see the ollama service's command). 8B judges more
# reliably than a smaller model (see TODO.md's finding on llama3.2:3b) but
# wants GPU acceleration (docker-compose.gpu.yml) to stay fast — on CPU
# alone, drop to a smaller tag like llama3.2:3b instead.
#
# If OLLAMA_URL points at claude-shim instead of ollama (see
# claude-shim/README.md), this must be a real Claude model alias (e.g.
# "haiku", "sonnet") — not an Ollama tag.
AI_TUNER_MODEL=llama3:8b

# Only CRS matches at least this severe are worth analyzing — low-severity
# noise isn't. Numeric code, lower = more severe (0=Emergency..7=Debug,
# matching ModSecurity's convention). Default 3 = Error and anything more
# severe (Emergency/Alert/Critical/Error).
AI_TUNER_MIN_SEVERITY_CODE=3

# CRS rule categories (by tag, comma-separated) that never reach crs-tuner at
# all, regardless of severity — no LLM verdict, confidence, or repeat count
# can ever generate an exclusion for these, because they're CRS's real
# attack-signature categories (SQLi, XSS, RCE, LFI/RFI, scanner detection,
# ...), not the generic protocol/format anomaly noise the tuning loop is
# meant to reduce. Verified necessary empirically: a small local model
# repeatedly judged genuine SQLi/XSS/RCE/LFI/scanner matches "false
# positive" under repeated similar traffic (see TODO.md) — this isn't tuned
# away by raising AI_TUNER_FP_THRESHOLD or AI_TUNER_CONFIDENCE_MIN, since
# the model was often *confident* and *consistent* about being wrong.
AI_TUNER_INELIGIBLE_TAGS=attack-sqli,attack-xss,attack-rce,attack-lfi,attack-rfi,attack-php-injection,attack-nodejs-injection,attack-session-fixation,attack-reputation-scanner,attack-disclosure,attack-injection-generic

# How many independent "false positive" verdicts for the same
# (domain, rule, variable) combination before crs-tuner actually generates
# and hot-loads an exclusion. Higher = slower to adapt but safer against a
# single bad judgment; don't set this to 1 without understanding that
# trade-off.
AI_TUNER_FP_THRESHOLD=3

# Minimum confidence (0-1) a "false positive" verdict needs before it counts
# toward the threshold above at all.
AI_TUNER_CONFIDENCE_MIN=0.7

# ============================================================
# Let's Encrypt sidecar (letsencrypt-sidecar/)
# ============================================================
# Opt-in (COMPOSE_PROFILES above must include "letsencrypt"). Issues and
# renews real certs for any routes.csv row with letsencrypt=true, dropping
# them into the same envoy/ssl/ directory the self-signed flow
# (generate-cert.sh) also uses — envoy-control-plane hot-reloads either
# kind identically. Real issuance needs a real, owned, publicly-resolvable
# domain with port 80 reachable from the internet (Let's Encrypt's HTTP-01
# challenge requirement) — this repo's own *.example.com domains can never
# actually succeed, by design of ACME validation, not a bug here.

# Required if the "letsencrypt" profile is enabled — Let's Encrypt requires
# a contact email for the ACME account (expiry notices, abuse contact).
LETSENCRYPT_EMAIL=

# true (default): use Let's Encrypt's staging environment, which has no
# real-world trust (browsers will not accept the cert) but also no
# meaningful rate limits — safe to leave on while testing. Set to false
# only once you are ready to request real, trusted certificates (subject
# to Let's Encrypt's production rate limits).
LETSENCRYPT_STAGING=true

# Fixed at 80 in any real deployment — that is the ACME HTTP-01 challenge
# protocol's requirement, not a configurable choice on Let's Encrypt's end.
# Only change this for local testing against a non-standard ACME server.
ACME_HTTP01_PORT=80

# How many days before expiry letsencrypt-sidecar renews a certificate.
ACME_RENEW_DAYS_BEFORE=30

# How often (hours) letsencrypt-sidecar checks every letsencrypt=true
# domain's certificate and renews if within ACME_RENEW_DAYS_BEFORE of
# expiry (or issues one for the first time if none exists yet).
ACME_CHECK_INTERVAL_H=12
